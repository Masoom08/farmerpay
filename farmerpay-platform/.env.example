# ============================================================
# FarmerPay Platform — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ---- Application ----
NODE_ENV=development
PORT=3000
APP_NAME=FarmerPay
APP_URL=http://localhost:3000
API_PREFIX=/api/v1

# ---- MySQL Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=farmerpay_dev
DB_USER=farmerpay_user
DB_PASSWORD=your_db_password_here
DB_DIALECT=mysql
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_LOGGING=true

# Read replica (production only — leave blank for dev)
DB_READ_HOST=
DB_READ_PORT=3306
DB_READ_USER=
DB_READ_PASSWORD=

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=fp:
REDIS_DEFAULT_TTL=3600

# ---- RabbitMQ ----
RABBITMQ_URL=amqp://farmerpay:farmerpay@127.0.0.1:5672
RABBITMQ_EXCHANGE=farmerpay_exchange
RABBITMQ_PREFETCH=10

# ---- JWT Authentication ----
JWT_ACCESS_SECRET=your_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars
JWT_ACCESS_EXPIRY=30m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=farmerpay-platform

# ---- OTP Configuration ----
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_OTP_MAX=5

# ---- Encryption Keys (REQUIRED — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ----
AADHAAR_ENCRYPTION_KEY=your_64_char_hex_key_here
BANK_ENCRYPTION_KEY=your_64_char_hex_key_here

# ---- Finacle Webhook ----
FINACLE_WEBHOOK_SECRET=your_finacle_webhook_hmac_secret_here

# ---- AWS General ----
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ---- AWS S3 ----
S3_BUCKET_NAME=farmerpay-uploads
S3_BUCKET_REGION=ap-south-1
S3_PRESIGNED_URL_EXPIRY=3600
S3_MAX_FILE_SIZE=10485760

# ---- AWS KMS ----
KMS_KEY_ID=your_kms_key_id
KMS_REGION=ap-south-1

# ---- AWS SES / Email ----
EMAIL_PROVIDER=ses
SES_REGION=ap-south-1
EMAIL_FROM=noreply@farmerpay.in
EMAIL_FROM_NAME=FarmerPay

# SMTP fallback (if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password

# ---- SMS Gateway ----
SMS_PROVIDER=twilio
SMS_API_KEY=your_sms_api_key
SMS_API_SECRET=your_sms_api_secret
SMS_SENDER_ID=FRMPAY

# ---- Bhashini API (Multi-language Translation) ----
BHASHINI_API_URL=https://meity-auth.ulcacontrib.org
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_DEFAULT_LANG=en
BHASHINI_SUPPORTED_LANGS=en,hi,bn,te,mr,ta,gu,kn,ml,pa,or

# ---- AI / ML Services ----
AI_SERVICE_URL=http://localhost:5000
AI_API_KEY=your_ai_api_key

# ---- Weather API ----
WEATHER_API_URL=https://api.openweathermap.org/data/2.5
WEATHER_API_KEY=your_weather_api_key

# ---- Mandi (Market Price) API ----
MANDI_API_URL=https://api.data.gov.in/resource
MANDI_API_KEY=your_mandi_api_key

# ---- Feature Flags ----
FEATURE_BHASHINI_TRANSLATION=true
FEATURE_AI_ADVISORY=false
FEATURE_WEATHER_ALERTS=true
FEATURE_MANDI_PRICES=true
FEATURE_SMS_NOTIFICATIONS=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_PUSH_NOTIFICATIONS=false

# ---- Readiness Feature Gates (per-persona rollout) ----
# Default OFF in production. Set to true in staging for progressive rollout.
FEATURE_READINESS_FARMER_BADGE=false
FEATURE_READINESS_SATHI_COACHING=false
FEATURE_READINESS_BANKER_MATRIX=false
# Shadow log: Sathi dashboard logs which readiness fields it reads.
# Enable for ~1 week before deleting FHS code paths from Sathi bundle.
FEATURE_READINESS_SATHI_SHADOW_LOG=false

# ---- PULSE Phase 3 (live ingestion + forecast model) ----
# Default OFF — uses deterministic mock generator. Flip to true and set
# PULSE_AGMARKNET_API_KEY to call the real data.gov.in Agmarknet API.
PULSE_AGMARKNET_LIVE=false
PULSE_AGMARKNET_API_KEY=
# Default ON — runs the SMA-SEASONAL-v1 model after every ingest.
PULSE_FORECAST_ENABLED=true
# Default ON — daily SENTINEL scan that emits market_risk EwsSignals.
PULSE_SENTINEL_SCAN_ENABLED=true

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8081

# ---- Account Aggregator (AA) ----
# Set AA_ENABLED=true to enable HMAC verification and real provider calls.
# In dev mode (false), mock responses are used and HMAC is skipped.
AA_ENABLED=false
AA_ACTIVE_PROVIDER=setu
AA_SETU_WEBHOOK_SECRET=your_setu_webhook_secret
AA_FINVU_WEBHOOK_SECRET=your_finvu_webhook_secret
AA_SETU_CLIENT_ID=your_setu_client_id
AA_SETU_CLIENT_SECRET=your_setu_client_secret
AA_SETU_PRODUCT_INSTANCE_ID=
AA_FINVU_API_KEY=
AA_FINVU_API_SECRET=
# Opt-in strict enforcement: reject webhooks that arrive without a
# freshness timestamp. Leave unset/false in dev; set to `true` in
# staging + prod once every upstream AA provider reliably sends one.
AA_STRICT_TIMESTAMP=false

# ---- Admin Session (EJS admin UI) ----
# REQUIRED in production. src/app.js refuses to start if this is missing
# when NODE_ENV=production.
ADMIN_SESSION_SECRET=your_admin_session_secret_min_32_chars

# ---- Gold Loan IBJA Prices ----
# REQUIRED before any gold-loan LTV endpoint will work. Source these
# from a signed daily feed (IBJA API or an internal ingestion job);
# hardcoded fallbacks were removed in the security audit so stale/
# wrong prices can't silently drive margin calls or mask LTV breaches.
#
# Gold loan endpoints return 503 GOLD_PRICE_UNAVAILABLE until set.
# Prices are rejected if outside [2000, 20000] ₹/g or if the AS_OF
# date is more than 2 days in the past.
IBJA_PRICE_22K=
IBJA_PRICE_24K=
# Optional: ISO-8601 date (YYYY-MM-DD) the above prices were quoted.
# Defaults to today. Override when ingesting prices from a source
# that may lag the current date.
IBJA_PRICE_AS_OF=

# ---- Logging ----
LOG_LEVEL=debug
LOG_DIR=logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d
