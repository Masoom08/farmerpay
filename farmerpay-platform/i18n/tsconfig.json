{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "declaration": true
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
