<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title || 'FarmerPay Bank Ops' %></title>
  <style>
    :root {
      --bg: #f5f7fa; --card: #fff; --ink: #1b2a3c; --muted: #5b6b7d; --line: #e1e6ec;
      --green: #2e7d32; --green-bg: #e8f5e9;
      --red: #c62828; --red-bg: #fbe9e7;
      --amber: #e65100; --amber-bg: #fff3e0;
      --blue: #1565c0; --blue-bg: #e3f2fd;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif; background: var(--bg); color: var(--ink); }
    a { color: var(--blue); text-decoration: none; }
    a:hover { text-decoration: underline; }
    header.admin-nav {
      background: #1b5e20; color: #fff; padding: 12px 24px;
      display: flex; align-items: center; gap: 24px;
      box-shadow: 0 1px 3px rgba(0,0,0,.1);
    }
    header.admin-nav .brand { font-weight: 800; font-size: 16px; }
    header.admin-nav .brand a { color: #fff; }
    header.admin-nav nav { display: flex; gap: 16px; flex: 1; }
    header.admin-nav nav a { color: #c8e6c9; font-weight: 600; }
    header.admin-nav nav a:hover { color: #fff; text-decoration: none; }
    header.admin-nav .user { font-size: 12px; color: #c8e6c9; }
    header.admin-nav .user .badge {
      display: inline-block; background: rgba(255,255,255,.15); border-radius: 4px;
      padding: 2px 6px; margin-left: 6px; font-size: 11px;
    }
    main.admin-main { max-width: 1200px; margin: 24px auto; padding: 0 24px; }
    h1 { font-size: 22px; margin: 0 0 16px; }
    h2 { font-size: 16px; margin: 24px 0 12px; }
    .card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 20px; margin-bottom: 16px; }
    .card h2:first-child { margin-top: 0; }
    .grid { display: grid; gap: 16px; }
    .grid-2 { grid-template-columns: 1fr 1fr; }
    .grid-3 { grid-template-columns: repeat(3, 1fr); }
    .grid-4 { grid-template-columns: repeat(4, 1fr); }
    .grid-5 { grid-template-columns: repeat(5, 1fr); }
    .kpi { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 16px; }
    .kpi .label { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .5px; }
    .kpi .value { font-size: 24px; font-weight: 800; margin-top: 4px; }
    .kpi .sub { font-size: 12px; color: var(--muted); margin-top: 4px; }
    .kpi.delta-down .value { color: var(--green); }
    .kpi.delta-up .value { color: var(--red); }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    table th, table td { padding: 8px 12px; text-align: left; border-bottom: 1px solid var(--line); }
    table th { background: #f8fafc; font-weight: 700; font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .3px; }
    table tr:hover { background: #fbfcfd; }
    .pill { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 700; }
    .pill-green { background: var(--green-bg); color: var(--green); }
    .pill-red { background: var(--red-bg); color: var(--red); }
    .pill-amber { background: var(--amber-bg); color: var(--amber); }
    .pill-blue { background: var(--blue-bg); color: var(--blue); }
    .pill-grey { background: #eceff1; color: #455a64; }
    .btn {
      display: inline-block; background: var(--green); color: #fff; border: none; border-radius: 6px;
      padding: 10px 18px; font-size: 13px; font-weight: 700; cursor: pointer; text-decoration: none;
    }
    .btn:hover { background: #1b5e20; text-decoration: none; }
    .btn-secondary { background: #fff; color: var(--ink); border: 1px solid var(--line); }
    .btn-danger { background: var(--red); }
    input[type=text], input[type=email], input[type=password], input[type=date], input[type=file], select {
      width: 100%; padding: 10px 12px; font: inherit; border: 1px solid var(--line); border-radius: 6px; background: #fff;
    }
    input:focus, select:focus { outline: 2px solid var(--blue); outline-offset: -1px; border-color: var(--blue); }
    label { display: block; font-size: 12px; font-weight: 700; color: var(--muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: .3px; }
    .form-row { margin-bottom: 16px; }
    .alert { padding: 12px 16px; border-radius: 6px; margin-bottom: 16px; font-size: 13px; }
    .alert-error { background: var(--red-bg); color: var(--red); border: 1px solid #ffcdd2; }
    .alert-info { background: var(--blue-bg); color: var(--blue); border: 1px solid #bbdefb; }
    .muted { color: var(--muted); }
    .right { text-align: right; }
    .nowrap { white-space: nowrap; }
    .filter-bar { background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; margin-bottom: 16px; display: flex; gap: 12px; align-items: end; }
    .filter-bar .form-row { margin: 0; flex: 0 0 auto; }
    .filter-bar input { width: 160px; }
  </style>
  <% if (typeof useChartJs !== 'undefined' && useChartJs) { %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <% } %>
</head>
<body>
  <% if (typeof admin !== 'undefined' && admin) { %>
  <header class="admin-nav">
    <div class="brand">🌾 <a href="/admin">FarmerPay Bank Ops</a></div>
    <nav>
      <a href="/admin/imports">Imports</a>
      <a href="/admin/imports/new">+ New upload</a>
      <a href="/admin/reports/aggregate">Cohort report</a>
    </nav>
    <div class="user">
      <%= admin.name || admin.email %>
      <span class="badge"><%= admin.role %></span>
      <% if (admin.bankNameScope) { %><span class="badge"><%= admin.bankNameScope %></span><% } %>
      &nbsp;·&nbsp;
      <a href="/admin/logout" style="color: #ffcdd2;">Logout</a>
    </div>
  </header>
  <% } %>
  <main class="admin-main">
