{
  "name": "farmerpay-platform",
  "version": "1.0.0",
  "description": "FarmerPay — Full-Stack Agrarian Fintech Platform for India",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "start:pm2": "pm2 start ecosystem.config.js",
    "stop:pm2": "pm2 stop farmerpay-platform",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:seed:undo": "npx sequelize-cli db:seed:undo:all",
    "test": "jest --coverage --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:integration": "jest -c jest.integration.config.js --forceExit --detectOpenHandles",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "a11y:sathi": "cd dashboard-sathi && npm run a11y",
    "a11y:banker": "cd dashboard && npm run a11y",
    "a11y:all": "npm run a11y:sathi && npm run a11y:banker",
    "e2e:playwright": "npx playwright test --project=banker --project=sathi",
    "e2e:detox:android": "cd farmer-app && detox test --configuration android.emu.debug",
    "e2e:detox:ios": "cd farmer-app && detox test --configuration ios.sim.debug",
    "e2e:ci": "npm run a11y:all && npx playwright test --project=banker --project=sathi",
    "check:handoff": "node scripts/check-handoff.js"
  },
  "keywords": [
    "farmerpay",
    "fintech",
    "agrarian",
    "india",
    "fpo",
    "agriculture"
  ],
  "author": "FarmerPay Team",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^0.10.3",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.15.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "ejs": "^5.0.1",
    "expo": "^55.0.15",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.19.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "mysql2": "^3.11.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "pdfkit": "^0.18.0",
    "rate-limit-redis": "^4.2.0",
    "sequelize": "^6.37.3",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.59.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
